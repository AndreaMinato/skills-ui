{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skills UI",
  "version": "0.1.1",
  "identifier": "com.aminato.skillsui",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Skills UI",
        "width": 1100,
        "height": 760
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg3RUI4OTZFOEM1MDE2OTkKUldTWkZsQ01ib25yaHg1bDBrZmJ6YjhNY2pIajFoR0ozMEY2THd5LzVJb3poOUt2VmljcmtqNncK",
      "endpoints": [
        "https://github.com/AndreaMinato/skills-ui/releases/latest/download/latest.json"
      ]
    }
  }
}
